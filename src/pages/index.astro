---
import Layout from '../layouts/Layout.astro';
import { getProjects, getCorporateData } from '../lib/cms';

const projects = await getProjects();
const corp = getCorporateData();
---

<Layout title="IKOS Luxury Developments — Ultra Luxury, Custom Homes">
  
  <!-- CORE CANVAS WRAPPER: Warm off-white background (#F9F6F0) and dark text -->
  <div class="bg-linen min-h-screen text-obsidian flex flex-col items-center">
    
    <!-- 1. HERO FRONT PAGE (Directly matching requirements) -->
    <section class="w-full flex flex-col items-center justify-center min-h-[90vh] px-6 py-16 text-center max-w-5xl mx-auto">
      
      <!-- Main Title (Centered Uppercase Headline with "LUXURY" italicized in premium serif font) -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-serif text-obsidian leading-[1.1] tracking-tight mb-6 uppercase">
        ULTRA <span class="italic font-serif font-light text-bronze-dark">LUXURY</span>, <br class="hidden md:inline" />
        CUSTOM HOMES.
      </h1>

      <!-- Subheadline -->
      <p class="text-sm md:text-lg lg:text-xl text-obsidian/75 max-w-2xl leading-relaxed mb-10 font-light">
        From start to finish, IKOS provides a seamless and elevated building experience.
      </p>

      <!-- Custom Emblem: Scaled, crisp, black inline SVG split-circle logo -->
      <div class="mb-10 flex justify-center items-center">
        <svg class="w-20 h-20 text-obsidian max-w-24 max-h-24 hover:text-bronze-dark transition-colors duration-500" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <title>IKOS Emblem</title>
          <path d="M 5.55 43 A 45 45 0 0 1 94.45 43 L 77.11 43 A 28 28 0 0 0 22.89 43 Z" fill="currentColor" />
          <path d="M 94.45 57 A 45 45 0 0 1 5.55 57 L 22.89 57 A 28 28 0 0 0 77.11 57 Z" fill="currentColor" />
        </svg>
      </div>

      <!-- Rounded pill-shaped "Contact Us" outline button -->
      <div class="animate-fade-in">
        <a href="/inquire" class="inline-block border border-obsidian hover:border-bronze-dark hover:bg-obsidian hover:text-linen text-obsidian px-10 py-4 rounded-full text-xs uppercase tracking-[0.25em] font-semibold transition-all duration-300 shadow-sm hover:shadow-md">
          Contact Us
        </a>
      </div>

    </section>

    <!-- divider -->
    <div class="w-full border-t border-bronze/10 max-w-7xl mx-auto"></div>

    <!-- 2. SUB-PAGE INTEGRATION (Structured cleanly beneath the fold) -->

    <!-- A. HISTORY EXPOSÉ SECTION -->
    <section class="w-full py-24 px-6 lg:px-12 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold block">HERITAGE OF MASTERPIECES</span>
          <h2 class="text-3xl md:text-5xl font-serif text-obsidian tracking-tight leading-tight">
            High Fashion Meets <br />
            <span class="italic text-bronze-dark font-light">Operational Precision</span>
          </h2>
          <p class="text-xs uppercase tracking-widest text-obsidian/45 font-sans font-semibold">Elena Achilleos & Stamos Chalapas</p>
          <p class="text-sm text-obsidian/70 leading-relaxed font-light font-sans">
            Our atelier marries forty years of haute couture curation with thirty years of bulletproof international financial operations. The results are bespoke Calgary estates built to transcend generations.
          </p>
          <div class="pt-4">
            <a href="/history" class="inline-block border-b border-obsidian text-xs uppercase tracking-widest text-obsidian pb-1 font-semibold hover:text-bronze-dark hover:border-bronze-dark transition-all duration-300">
              Explore Our History &rarr;
            </a>
          </div>
        </div>

        <!-- Founders Side-by-Side Panel -->
        <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- Elena Card -->
          <div class="bg-white/50 border border-bronze/10 p-8 relative group hover:border-bronze-dark transition-all duration-500">
            <div class="absolute top-0 left-0 w-1.5 h-0.5 bg-bronze-dark"></div>
            <span class="text-[9px] uppercase tracking-widest text-bronze-dark font-semibold">AESTHETIC DIRECTOR</span>
            <h3 class="text-xl font-serif text-obsidian mt-2">{corp.founders.elena.name}</h3>
            <p class="text-[9px] text-obsidian/40 uppercase tracking-widest font-semibold mb-4">{corp.founders.elena.experience}</p>
            <p class="text-xs text-obsidian/60 leading-relaxed font-sans font-light">
              Guiding every spatial volume, custom Marmorino plaster treatment, and travertine quarry selection with editiorial, haute couture precision.
            </p>
          </div>

          <!-- Stamos Card -->
          <div class="bg-white/50 border border-bronze/10 p-8 relative group hover:border-bronze-dark transition-all duration-500">
            <div class="absolute top-0 left-0 w-1.5 h-0.5 bg-bronze-dark"></div>
            <span class="text-[9px] uppercase tracking-widest text-bronze-dark font-semibold">OPERATIONS DIRECTOR</span>
            <h3 class="text-xl font-serif text-obsidian mt-2">{corp.founders.stamos.name}</h3>
            <p class="text-[9px] text-obsidian/40 uppercase tracking-widest font-semibold mb-4">{corp.founders.stamos.experience}</p>
            <p class="text-xs text-obsidian/60 leading-relaxed font-sans font-light">
              Enforcing absolute schedule compliance, material pipeline transparency, and robust risk matrices on every single pour and steel framing coordinate.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- divider -->
    <div class="w-full border-t border-bronze/10 max-w-7xl mx-auto"></div>

    <!-- B. SERVICES EXPOSÉ SECTION -->
    <section class="w-full py-24 px-6 lg:px-12 max-w-7xl mx-auto bg-white/30">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold block mb-4">OUR DESIGN WORKSHOPS</span>
        <h2 class="text-3xl md:text-5xl font-serif text-obsidian tracking-tight">The 4 Custom Pillars</h2>
        <p class="text-sm text-obsidian/60 leading-relaxed font-light mt-3">
          We oversee the entire lifecyle of your custom home, removing the volatile gaps between design and execution.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <!-- Pillar 1 -->
        <div class="p-6 border border-bronze/10 bg-white/40 flex flex-col justify-between hover:border-bronze-dark transition-all duration-300">
          <div>
            <span class="text-2xl font-serif text-bronze-dark/30 font-semibold block mb-4">I</span>
            <h3 class="text-lg font-serif text-obsidian font-semibold mb-2">Architectural Collaboration</h3>
            <p class="text-xs text-obsidian/60 leading-relaxed font-light">
              Bespoke envelopes engineered specifically for Calgary's sub-zero climate vectors, ensuring complete environmental and structural quietude.
            </p>
          </div>
          <div class="border-t border-bronze/10 pt-4 mt-6 text-[9px] uppercase tracking-widest text-bronze-dark font-medium">
            Est. Phase-01
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="p-6 border border-bronze/10 bg-white/40 flex flex-col justify-between hover:border-bronze-dark transition-all duration-300">
          <div>
            <span class="text-2xl font-serif text-bronze-dark/30 font-semibold block mb-4">II</span>
            <h3 class="text-lg font-serif text-obsidian font-semibold mb-2">Global Product Procurement</h3>
            <p class="text-xs text-obsidian/60 leading-relaxed font-light">
              Securing premium limestone blocks from private Tuscan quarries and German triple-glazed glass profiles directly to avoid local supply delays.
            </p>
          </div>
          <div class="border-t border-bronze/10 pt-4 mt-6 text-[9px] uppercase tracking-widest text-bronze-dark font-medium">
            Est. Phase-02
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="p-6 border border-bronze/10 bg-white/40 flex flex-col justify-between hover:border-bronze-dark transition-all duration-300">
          <div>
            <span class="text-2xl font-serif text-bronze-dark/30 font-semibold block mb-4">III</span>
            <h3 class="text-lg font-serif text-obsidian font-semibold mb-2">Interior Partnerships</h3>
            <p class="text-xs text-obsidian/60 leading-relaxed font-light">
              Forming end-to-end creative alliances with elite architectural design studios in Milan, Paris, and Athens.
            </p>
          </div>
          <div class="border-t border-bronze/10 pt-4 mt-6 text-[9px] uppercase tracking-widest text-bronze-dark font-medium">
            Est. Phase-03
          </div>
        </div>

        <!-- Pillar 4 -->
        <div class="p-6 border border-bronze/10 bg-white/40 flex flex-col justify-between hover:border-bronze-dark transition-all duration-300">
          <div>
            <span class="text-2xl font-serif text-bronze-dark/30 font-semibold block mb-4">IV</span>
            <h3 class="text-lg font-serif text-obsidian font-semibold mb-2">Premium Site Landscaping</h3>
            <p class="text-xs text-obsidian/60 leading-relaxed font-light">
              Restoring site topography and transplanting mature local evergreens to anchor your new monument seamlessly into the landscape.
            </p>
          </div>
          <div class="border-t border-bronze/10 pt-4 mt-6 text-[9px] uppercase tracking-widest text-bronze-dark font-medium">
            Est. Phase-04
          </div>
        </div>

      </div>

      <div class="text-center mt-12">
        <a href="/services" class="inline-block border-b border-obsidian text-xs uppercase tracking-widest text-obsidian pb-1 font-semibold hover:text-bronze-dark hover:border-bronze-dark transition-all duration-300">
          Review Detailed Services &rarr;
        </a>
      </div>
    </section>

    <!-- divider -->
    <div class="w-full border-t border-bronze/10 max-w-7xl mx-auto"></div>

    <!-- C. DYNAMIC PORTFOLIO SHOWCASE GRID (Gallery & Team Links) -->
    <section class="w-full py-24 px-6 lg:px-12 max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-6">
        <div>
          <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold block">ACTIVE BLUEPRINTS & MONOLITHS</span>
          <h2 class="text-3xl md:text-5xl font-serif text-obsidian tracking-tight mt-2">The Architectural Registry</h2>
        </div>
        <div class="flex items-center space-x-6 text-xs uppercase tracking-widest font-semibold">
          <a href="/team" class="text-obsidian/60 hover:text-bronze-dark transition-colors duration-300">Meet Curators</a>
          <span class="text-bronze/30">|</span>
          <a href="/gallery" class="text-obsidian border-b border-obsidian pb-0.5 hover:text-bronze-dark hover:border-bronze-dark transition-colors duration-300">View All Gallery</a>
        </div>
      </div>

      <!-- Dynamic Portfolio Loop from CMS using dynamic templates -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project, idx) => (
          <div class="bg-white/40 border border-bronze/10 overflow-hidden flex flex-col justify-between hover:border-bronze-dark transition-all duration-500 group relative">
            <div class="absolute top-0 left-0 w-0 h-[2px] bg-bronze-dark group-hover:w-full transition-all duration-500"></div>
            
            <!-- Image Area -->
            <a href={`/projects/${project.slug}`} class="block overflow-hidden relative aspect-[16/10] bg-linen">
              <img 
                src={project.imageUrl} 
                alt={project.title} 
                class="w-full h-full object-cover transform scale-100 group-hover:scale-105 transition-transform duration-[1s]" 
                transition:name={`project-image-${project.slug}`}
              />
              <div class="absolute inset-0 bg-black/5 group-hover:bg-black/0 transition-colors duration-500"></div>
            </a>

            <!-- Content Area -->
            <div class="p-6 flex flex-col justify-between flex-grow">
              <div>
                <div class="flex items-center justify-between text-[9px] uppercase tracking-widest text-bronze-dark font-semibold mb-2">
                  <span>REGISTRY FILE 0{idx+1}</span>
                  <span>{project.location.split(' — ')[0]}</span>
                </div>
                <h3 class="text-xl font-serif text-obsidian group-hover:text-bronze-dark transition-colors duration-300 font-semibold mb-1">
                  <a href={`/projects/${project.slug}`}>
                    {project.title}
                  </a>
                </h3>
                <p class="text-[10px] uppercase tracking-widest text-obsidian/40 italic font-serif mb-3">{project.subtitle}</p>
                <p class="text-xs text-obsidian/70 leading-relaxed font-sans font-light mb-4">
                  {project.description}
                </p>
              </div>

              <!-- Card Specs footer -->
              <div class="border-t border-bronze/10 pt-4 mt-4 flex items-center justify-between">
                <span class="text-[9px] uppercase tracking-widest text-obsidian/50 font-semibold">{project.scale}</span>
                <a href={`/projects/${project.slug}`} class="flex items-center space-x-1.5 text-[9px] uppercase tracking-widest text-bronze-dark font-semibold hover:text-obsidian transition-colors duration-300">
                  <span>Deconstruct Spec</span>
                  <!-- Small arrow with absolute boundary limits to prevent massive scaling -->
                  <svg class="w-3 h-3 max-w-4 max-h-4 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- D. DETAILED GEOGRAPHIC ZONE SCOPE (Charcoal/Obsidian Dark Filtered Map Container) -->
    <section class="w-full py-24 px-6 lg:px-12 border-t border-bronze/10 relative max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <span class="text-[10px] uppercase tracking-epic text-bronze-dark block font-semibold">GEOGRAPHIC GEOMETRY</span>
          <h2 class="text-3xl md:text-4xl font-serif text-obsidian tracking-tight">Active Foothills Belts</h2>
          <p class="text-xs uppercase tracking-widest text-obsidian/45 font-sans font-semibold">Springbank & Elbow Valley</p>
          <p class="text-sm text-obsidian/70 leading-relaxed font-sans font-light">
            We target beautiful, high-acreage custom tracts in standard development zones. Each estate contour is mapped across solar pathways and mountain silhouettes.
          </p>
          <div class="pt-4">
            <a href="/inquire" class="inline-block border border-obsidian/30 hover:border-obsidian px-6 py-3 rounded-full text-xs uppercase tracking-widest text-obsidian hover:bg-obsidian hover:text-linen transition-all duration-300">
              Request Site Selection Map
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <!-- Perfectly isolated absolute scale boundary frame mapping -->
          <div class="relative w-full h-[400px] border border-bronze/15 overflow-hidden shadow-sm">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d80315.6562479427!2d-114.321876!3d51.018991!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x53716dedfa5ee11f%3A0xc3457223049bd928!2sSpringbank%2C%20AB!5e0!3m2!1sen!2sca!4v1700000000000!5m2!1sen!2sca" 
              class="w-full h-full border-0 absolute inset-0 z-0 grayscale opacity-80"
              style="filter: invert(90%) hue-rotate(180deg) brightness(95%) contrast(90%);"
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="IKOS Calgary Development Zone Map"
            ></iframe>
            
            <div class="absolute bottom-6 left-6 z-20 bg-linen/95 border border-bronze-dark/30 px-4 py-2 flex items-center space-x-2 shadow-sm rounded-none">
              <span class="w-2 h-2 rounded-full bg-bronze-dark animate-pulse inline-block"></span>
              <span class="text-[9px] uppercase tracking-widest text-obsidian font-semibold">Active Calgary Foothills Belt</span>
            </div>
          </div>
        </div>

      </div>
    </section>

  </div>

</Layout>
