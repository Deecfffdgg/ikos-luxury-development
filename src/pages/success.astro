---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inquiry Registered — IKOS Luxury Developments">
  <section class="min-h-[75vh] flex flex-col justify-center items-center bg-linen py-24 px-6 text-obsidian">
    <div class="max-w-xl text-center flex flex-col items-center">
      
      <!-- Icon indicator with bounded SVG scales -->
      <div class="w-16 h-16 rounded-full border border-bronze-dark flex items-center justify-center mb-8 animate-bounce">
        <svg class="w-6 h-6 text-bronze-dark max-w-8 max-h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>

      <!-- Tag -->
      <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold mb-4">COMMISSION REGISTRY APPLIED</span>

      <!-- Title -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-serif text-obsidian mb-6 uppercase">Inquiry Registered</h1>
      
      <!-- Content -->
      <p class="text-sm text-obsidian/75 leading-relaxed font-light mb-10 font-sans">
        Thank you for submitting your custom estate narrative. Your architectural parameters have been registered under private file credentials. 
        An IKOS Curation Lead Director will review your topography requests and contact you via your specified secure channels within 48 business hours.
      </p>

      <!-- CTA -->
      <a href="/" class="bg-obsidian hover:bg-bronze-dark text-linen hover:text-obsidian font-semibold px-8 py-3.5 rounded-full text-xs uppercase tracking-widest transition-all duration-300">
        Return to Sanctuary Portfolio
      </a>

    </div>
  </section>
</Layout>
