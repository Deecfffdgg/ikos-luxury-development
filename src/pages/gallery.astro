---
import Layout from '../layouts/Layout.astro';
import { getProjects } from '../lib/cms';

const projects = await getProjects();
const galleryHero = "https://ikosluxurydevelopments.com/wp-content/uploads/2024/11/4.-IMG_2991-edit-WMK.jpg";
---

<Layout title="The Gallery — IKOS Luxury Developments" description="A masonry exhibition showcasing our custom homes, architectural legacy estates, and concept renderings across Calgary, Alberta.">
  
  <!-- GALLERY HERO (Light Luxury Style) -->
  <section class="relative w-full h-[45vh] overflow-hidden flex items-end bg-linen border-b border-bronze/10">
    <div class="absolute inset-0 z-0">
      <img 
        src={galleryHero} 
        alt="IKOS Glass Pavilion Evening View" 
        class="w-full h-full object-cover opacity-15" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-linen via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full pb-12">
      <div class="flex items-center space-x-3 mb-3">
        <span class="w-8 h-px bg-bronze-dark max-w-8"></span>
        <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold">THE GALLERY OF RECORD</span>
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-serif text-obsidian tracking-tight uppercase">The Masterwork Portfolio</h1>
    </div>
  </section>

  <!-- PORTFOLIO GRID -->
  <section class="py-20 bg-linen relative max-w-7xl mx-auto px-6 lg:px-12 animate-fade-in">
    
    <!-- Section Intro -->
    <div class="max-w-2xl mb-12">
      <span class="text-[10px] uppercase tracking-widest text-bronze-dark block font-semibold mb-2">01 — DIGITAL ARCHIVE</span>
      <h2 class="text-2xl md:text-3xl font-serif text-obsidian tracking-tight uppercase">Active & Completed Commissions</h2>
      <p class="text-sm text-obsidian/60 leading-relaxed font-sans font-light mt-2">
        Explore the visual blueprints and material realities of our elite Calgary custom builds. Each project represents an uncompromising pursuit of architectural quietude, leveraging raw concrete formwork, and maximum structural glass transparency.
      </p>
    </div>

    <!-- Masonry Exhibition Layout (Light themed cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project, index) => (
        <div class="group bg-white border border-bronze/10 overflow-hidden flex flex-col justify-between hover:border-bronze-dark transition-all duration-500 relative">
          <div class="absolute top-0 left-0 w-0 h-[2px] bg-bronze-dark group-hover:w-full transition-all duration-500"></div>
          
          <!-- Card Image -->
          <a href={`/projects/${project.slug}`} class="block overflow-hidden relative aspect-[16/10] bg-linen">
            <img 
              src={project.imageUrl} 
              alt={project.title} 
              class="w-full h-full object-cover transform scale-100 group-hover:scale-105 transition-transform duration-[1s]" 
              transition:name={`project-image-${project.slug}`}
            />
            <div class="absolute inset-0 bg-black/5 group-hover:bg-black/0 transition-colors duration-500"></div>
          </a>

          <!-- Card Content -->
          <div class="p-6 flex flex-col justify-between flex-grow">
            <div>
              <div class="flex items-center justify-between text-[10px] uppercase tracking-widest text-bronze-dark font-semibold mb-2">
                <span>0{index + 1} — Project</span>
                <span>{project.location.split(' — ')[0]}</span>
              </div>
              <h3 class="text-xl font-serif text-obsidian group-hover:text-bronze-dark transition-colors duration-300 mb-1 font-semibold">
                <a href={`/projects/${project.slug}`}>
                  {project.title}
                </a>
              </h3>
              <p class="text-[10px] uppercase tracking-widest text-obsidian/40 italic font-serif mb-3">{project.subtitle}</p>
              <p class="text-xs text-obsidian/70 leading-relaxed font-sans font-light mb-4">
                {project.description}
              </p>
            </div>

            <!-- Specs & Link -->
            <div class="border-t border-bronze/10 pt-4 mt-4 flex items-center justify-between">
              <span class="text-[9px] uppercase tracking-widest text-obsidian/50 font-semibold">{project.scale}</span>
              <a href={`/projects/${project.slug}`} class="flex items-center space-x-1 text-[9px] uppercase tracking-widest text-bronze-dark font-semibold hover:text-obsidian transition-colors duration-300">
                <span>Deconstruct Spec</span>
                <!-- Restricted SVG arrow boundary -->
                <svg class="w-3.5 h-3.5 max-w-4 max-h-4 transform group-hover:translate-x-1.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

  </section>

  <!-- CONCEPT SPECIFICATIONS GRID -->
  <section class="py-20 bg-white/40 border-t border-bronze/10 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      
      <div class="max-w-2xl mb-12">
        <span class="text-[10px] uppercase tracking-epic text-bronze-dark block font-semibold mb-2">02 — SPECIFICATION PARAMETERS</span>
        <h2 class="text-2xl md:text-3xl font-serif text-obsidian tracking-tight uppercase">Sourcing Excellence</h2>
        <p class="text-sm text-obsidian/60 font-sans font-light mt-2">
          We leverage rare materials, custom concrete curing technologies, and high-performance structural double glazing to deliver bespoke sanctuaries that resist the sub-zero winters of Western Canada while providing ultimate aesthetic transparency.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="border border-bronze/10 p-6 bg-white">
          <span class="text-xs uppercase tracking-widest text-bronze-dark font-semibold block mb-3">Concrete Metallurgy</span>
          <p class="text-xs text-obsidian/70 leading-relaxed font-sans font-light">
            Monolithic board-formed obsidian concrete custom-pigmented with dark minerals and poured on-site into custom timber frameworks, giving each wall a physical timber wood grain texture and bulletproof structural capacity.
          </p>
        </div>

        <div class="border border-bronze/10 p-6 bg-white">
          <span class="text-xs uppercase tracking-widest text-bronze-dark font-semibold block mb-3">Crystalline Glazing</span>
          <p class="text-xs text-obsidian/70 leading-relaxed font-sans font-light">
            Bespoke double-glazed and triple-glazed structural panels with razor-thin thermal profiles. These are certified to withstand -40°C temperature shifts without condensation or structural thermal bridging.
          </p>
        </div>

        <div class="border border-bronze/10 p-6 bg-white">
          <span class="text-xs uppercase tracking-widest text-bronze-dark font-semibold block mb-3">Acid Patina Metals</span>
          <p class="text-xs text-obsidian/70 leading-relaxed font-sans font-light">
            Custom hand-rubbed acid finishes applied directly onto bronze and architectural steel cladding, establishing a rich patina shield that deepens, matures, and self-heals in beautiful harmony with the native evergreen forest.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-linen text-center border-t border-bronze/10">
    <div class="max-w-4xl mx-auto px-6 flex flex-col items-center">
      <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold mb-3">INITIATE YOUR TIMELINE</span>
      <h2 class="text-2xl md:text-3xl font-serif text-obsidian mb-4 uppercase">Begin Your Site Evaluation Process</h2>
      <p class="text-xs text-obsidian/60 max-w-xl leading-relaxed font-sans font-light mb-6">
        Request private consultation and let our curators prepare an initial environmental simulation scan and material timeline spec sheet.
      </p>
      <a href="/inquire" class="bg-obsidian hover:bg-bronze-dark text-linen hover:text-obsidian font-semibold px-8 py-3.5 rounded-full text-xs uppercase tracking-widest transition-all duration-300">
        Initiate Site Evaluation
      </a>
    </div>
  </section>

</Layout>
