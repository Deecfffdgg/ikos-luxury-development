---
import Layout from '../layouts/Layout.astro';
import { getCorporateData } from '../lib/cms';

const corp = getCorporateData();
const teamHero = "https://ikosluxurydevelopments.com/wp-content/uploads/2025/01/IKOS-AboutUs-1-WMK.jpg";
---

<Layout title="The Team — IKOS Luxury Developments" description="Meet our founders, Elena Achilleos (Principal of Aesthetics) and Stamos Chalapas (Principal of Operations), and explore our dual approach to flawless luxury execution.">
  
  <!-- HERO SECTION (Light Luxury Style) -->
  <section class="relative w-full h-[45vh] overflow-hidden flex items-end bg-linen border-b border-bronze/10">
    <div class="absolute inset-0 z-0">
      <img 
        src={teamHero} 
        alt="IKOS Design Studio and Office" 
        class="w-full h-full object-cover opacity-15" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-linen via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full pb-12">
      <div class="flex items-center space-x-3 mb-3">
        <span class="w-8 h-px bg-bronze-dark max-w-8"></span>
        <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold">THE CURATORS</span>
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-serif text-obsidian tracking-tight uppercase">Our Founders & Leadership</h1>
    </div>
  </section>

  <!-- TEAM INTRODUCTION -->
  <section class="py-20 bg-linen relative max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <span class="text-[10px] uppercase tracking-widest text-bronze-dark block font-semibold mb-3">01 — DUAL PHILOSOPHY</span>
        <h2 class="text-2xl md:text-4xl font-serif text-obsidian tracking-tight leading-tight uppercase">
          A Symphony of <br />
          <span class="italic font-light text-bronze-dark">Art & Execution</span>
        </h2>
      </div>
      <div class="lg:col-span-7 text-sm text-obsidian/75 leading-relaxed font-sans font-light space-y-6">
        <p>
          We believe that flawless residential development cannot exist in a vacuum. It requires a permanent, creative friction between two distinct disciplines: the absolute aesthetic vision of the artist and the strict, operational rigor of the engineer.
        </p>
        <p>
          At IKOS, this duality is personified by our founders. Elena Achilleos guides the sensory, material, and spatial experience of each estate, while Stamos Chalapas commands the project mechanics, financial risk schedules, and structural longevity. Together, they ensure that your commission is both a timeless work of art and an immortal structural monument.
        </p>
      </div>
    </div>
  </section>

  <!-- ELENA'S EDITORIAL BIOGRAPHY SECTION -->
  <section class="py-20 bg-white/40 border-y border-bronze/10 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Elena's Image Frame -->
      <div class="lg:col-span-5 overflow-hidden border border-bronze/10 aspect-[3/4] bg-white relative group">
        <div class="absolute inset-0 bg-gradient-to-t from-linen/40 via-transparent to-transparent z-10"></div>
        <img 
          src="https://ikosluxurydevelopments.com/wp-content/uploads/2024/11/Elena-Achilleos_IKOS-LuxuryDevelopments.jpg" 
          alt="Elena Achilleos — Principal of Aesthetics" 
          class="w-full h-full object-cover grayscale opacity-90 group-hover:opacity-100 transition-all duration-1000"
        />
        <div class="absolute bottom-6 left-6 z-20">
          <span class="text-[9px] uppercase tracking-widest text-bronze-dark bg-linen border border-bronze-dark/20 px-4 py-1.5 font-semibold">Principal of Aesthetics</span>
        </div>
      </div>

      <!-- Elena's Bio Content -->
      <div class="lg:col-span-7 space-y-4">
        <span class="text-[10px] uppercase tracking-epic text-bronze-dark block font-semibold">THE AESTHETIC COMPASS</span>
        <h2 class="text-2xl md:text-4xl font-serif text-obsidian tracking-tight uppercase">{corp.founders.elena.name}</h2>
        <p class="text-[10px] uppercase tracking-widest text-obsidian/45 -mt-3 font-semibold">{corp.founders.elena.experience}</p>
        
        <div class="text-sm text-obsidian/75 leading-relaxed space-y-4 font-sans font-light">
          <p>
            {corp.founders.elena.bio}
          </p>
          <p class="italic font-serif text-base text-obsidian/90">
            "In European fashion curation, we learned that true luxury cannot be replicated with synthetic components or shortcut logic. It requires authentic, tactile materials that tell a story over time," Elena reflects. "I bring this exact ethos to IKOS. I do not design walls; I design visual narratives where light, shadow, stone, and space dialogue together in quiet elegance."
          </p>
        </div>

        <div class="border-t border-bronze/10 pt-4 mt-6">
          <span class="text-[9px] uppercase tracking-widest text-bronze-dark block mb-2 font-semibold">Elena's Design Directives</span>
          <div class="flex flex-wrap gap-2">
            <span class="bg-white/80 border border-bronze/10 text-obsidian/70 text-xs px-3 py-1 font-sans">Material Authenticity</span>
            <span class="bg-white/80 border border-bronze/10 text-obsidian/70 text-xs px-3 py-1 font-sans">Visual Proportion Scale</span>
            <span class="bg-white/80 border border-bronze/10 text-obsidian/70 text-xs px-3 py-1 font-sans">European Curation</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- STAMOS'S EDITORIAL BIOGRAPHY SECTION -->
  <section class="py-20 bg-linen relative max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Stamos's Bio Content -->
      <div class="lg:col-span-7 space-y-4 order-2 lg:order-1">
        <span class="text-[10px] uppercase tracking-epic text-bronze-dark block font-semibold">THE OPERATIONAL SHIELD</span>
        <h2 class="text-2xl md:text-4xl font-serif text-obsidian tracking-tight uppercase">{corp.founders.stamos.name}</h2>
        <p class="text-[10px] uppercase tracking-widest text-obsidian/45 -mt-3 font-semibold">{corp.founders.stamos.experience}</p>
        
        <div class="text-sm text-obsidian/75 leading-relaxed space-y-4 font-sans font-light">
          <p>
            {corp.founders.stamos.bio}
          </p>
          <p class="italic font-serif text-base text-obsidian/90">
            "A magnificent architectural design is only a digital dream until the first yard of board-formed concrete is poured and cured correctly under tight temperature tolerance," Stamos asserts. "My purpose at IKOS is to bring rigorous operational science and absolute financial clarity to our clients, ensuring their investment is delivered with standard schedule precision and structural immortality."
          </p>
        </div>

        <div class="border-t border-bronze/10 pt-4 mt-6">
          <span class="text-[9px] uppercase tracking-widest text-bronze-dark block mb-2 font-semibold">Stamos's Operational Shields</span>
          <div class="flex flex-wrap gap-2">
            <span class="bg-white border border-bronze/10 text-obsidian/70 text-xs px-3 py-1 font-sans font-semibold">Schedule Risk Management</span>
            <span class="bg-white border border-bronze/10 text-obsidian/70 text-xs px-3 py-1 font-sans font-semibold">Structural Integrity Modeling</span>
            <span class="bg-white border border-bronze/10 text-obsidian/70 text-xs px-3 py-1 font-sans font-semibold">Supply Chain Control</span>
          </div>
        </div>
      </div>

      <!-- Stamos's Image Frame -->
      <div class="lg:col-span-5 overflow-hidden border border-bronze/10 aspect-[3/4] bg-white relative group order-1 lg:order-2">
        <div class="absolute inset-0 bg-gradient-to-t from-linen/40 via-transparent to-transparent z-10"></div>
        <img 
          src="https://ikosluxurydevelopments.com/wp-content/uploads/2025/02/Chalapas-Stamos-scaled-e1739543544198.jpg" 
          alt="Stamos Chalapas — Principal of Operations" 
          class="w-full h-full object-cover grayscale opacity-90 group-hover:opacity-100 transition-all duration-1000"
        />
        <div class="absolute bottom-6 left-6 z-20">
          <span class="text-[9px] uppercase tracking-widest text-bronze-dark bg-linen border border-bronze-dark/20 px-4 py-1.5 font-semibold">Principal of Operations</span>
        </div>
      </div>

    </div>
  </section>

  <!-- DUAL COOPERATIVE CLOSING -->
  <section class="py-16 bg-white/40 border-t border-bronze/10 text-center">
    <div class="max-w-4xl mx-auto px-6 flex flex-col items-center">
      <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold mb-3">OUR PROMISE OF RECORD</span>
      <h2 class="text-2xl md:text-3xl font-serif text-obsidian mb-4 uppercase">Guaranteed Structural Immortality</h2>
      <p class="text-xs text-obsidian/60 max-w-xl leading-relaxed font-sans font-light mb-6">
        We personally review and sign off on each design stage and construction gateway file, ensuring that the legacy of our founders remains permanently woven into the foundation of your custom estate.
      </p>
      <a href="/inquire" class="bg-obsidian hover:bg-bronze-dark text-linen hover:text-obsidian font-semibold px-8 py-3.5 rounded-full text-xs uppercase tracking-widest transition-all duration-300">
        Initiate Leadership Consult
      </a>
    </div>
  </section>

</Layout>
