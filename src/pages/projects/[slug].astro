---
import Layout from '../../layouts/Layout.astro';
import { getProjects, getProjectBySlug } from '../../lib/cms';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

if (!project) {
  return Astro.redirect('/404');
}
---

<Layout title={`${project.title} — IKOS Luxury Developments`} description={project.description}>
  
  <!-- PROJECT HERO / CINEMATIC BANNER -->
  <section class="relative w-full h-[60vh] overflow-hidden flex items-end bg-linen border-b border-bronze/10">
    <!-- Hero Background Image -->
    <div class="absolute inset-0 z-0">
      <img 
        src={project.imageUrl} 
        alt={project.title} 
        class="w-full h-full object-cover opacity-20 transform scale-100 transition-transform duration-1000" 
        transition:name={`project-image-${project.slug}`}
      />
      <!-- Overlays -->
      <div class="absolute inset-0 bg-gradient-to-t from-linen via-linen/60 to-transparent"></div>
    </div>

    <!-- Title Meta Details -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full pb-12">
      
      <!-- Back to Gallery Link -->
      <a href="/gallery" class="inline-flex items-center space-x-2 text-xs uppercase tracking-widest text-bronze-dark hover:text-obsidian transition-colors duration-300 mb-6 group">
        <!-- Restricted boundary back arrow -->
        <svg class="w-4 h-4 max-w-5 max-h-4 transform group-hover:-translate-x-1.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span class="font-semibold">Back to Gallery</span>
      </a>

      <!-- Main Project Header -->
      <div class="max-w-4xl">
        <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold mb-2 block">BESPOKE ARCHITECTURAL MONUMENT</span>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-serif text-obsidian leading-none tracking-tight uppercase">
          {project.title}
        </h1>
        <p class="text-sm md:text-lg text-obsidian/80 italic font-serif mt-3 font-light max-w-2xl">
          {project.subtitle}
        </p>
      </div>

    </div>
  </section>

  <!-- SPECIFICATIONS MATRIX BAR -->
  <section class="bg-white border-b border-bronze/10 py-6 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-obsidian">
        
        <div>
          <span class="text-[9px] uppercase tracking-widest text-bronze-dark block mb-1 font-semibold">Location Zone</span>
          <span class="text-xs text-obsidian/90 font-serif italic">{project.location}</span>
        </div>

        <div>
          <span class="text-[9px] uppercase tracking-widest text-bronze-dark block mb-1 font-semibold">Project Scale</span>
          <span class="text-xs text-obsidian/90 font-serif italic">{project.scale}</span>
        </div>

        <div>
          <span class="text-[9px] uppercase tracking-widest text-bronze-dark block mb-1 font-semibold">Curation Lead</span>
          <span class="text-xs text-obsidian/90 font-serif italic">IKOS Studio</span>
        </div>

        <div>
          <span class="text-[9px] uppercase tracking-widest text-bronze-dark block mb-1 font-semibold">Est. Completion</span>
          <span class="text-xs text-obsidian/90 font-serif italic">{project.completionYear}</span>
        </div>

      </div>
    </div>
  </section>

  <!-- PROJECT SPECIFICATION DETAILS SECTION -->
  <section class="py-20 bg-linen relative max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Detailed Narrative (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Section Header -->
        <div>
          <span class="text-[10px] uppercase tracking-epic text-bronze-dark block mb-2 font-semibold">DESIGN CRITERIA & INTENTIONS</span>
          <h2 class="text-2xl md:text-3xl font-serif text-obsidian tracking-tight uppercase">Architectural Narrative</h2>
        </div>

        <!-- Long description content with beautiful formatting -->
        <div class="text-sm text-obsidian/75 leading-relaxed space-y-6 font-light font-sans">
          <p>
            {project.longDescription}
          </p>
          <p>
            Every line and shadow in this monument has been designed in strict accordance with the local topographical contours. Rather than imposing architectural force upon the landscape, the structure yields, framing environmental beauty through double-height low-profile glazing systems and expansive thermal buffers.
          </p>
          <p>
            The custom metallurgy and bronze plates used throughout the structure have been treated with hand-rubbed acid finishes, establishing a rich, self-healing patina layer that will age and deepen beautifully alongside the native evergreen forests.
          </p>
        </div>

        <!-- Callout Quote block -->
        <div class="border-l-2 border-bronze-dark pl-6 py-3 italic font-serif text-base md:text-lg text-obsidian/90 my-6 bg-white/40 pr-4">
          "Architecture is the freezeframe of a cultural legacy. In this commission, we sought to capture the silence of the Canadian Rockies and solidify it into raw, tactile concrete forms."
          <span class="block text-xs uppercase tracking-widest text-bronze-dark font-sans font-semibold not-italic mt-2">— Lead Curation Director, IKOS Studio</span>
        </div>

      </div>

      <!-- Right Column: Materials & Features Specs (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        
        <!-- Materials Deck -->
        <div class="bg-white border border-bronze/10 p-6 shadow-sm">
          <span class="text-[10px] uppercase tracking-epic text-bronze-dark block mb-4 font-semibold">ELEMENTAL MATERIAL SPECIFICATIONS</span>
          
          <ul class="divide-y divide-bronze/10">
            {project.materials.map((material, idx) => (
              <li class="py-2.5 flex items-center justify-between text-xs text-obsidian/85">
                <span class="font-serif italic text-sm">{material}</span>
                <span class="text-[9px] uppercase tracking-widest text-bronze-dark font-semibold">SPEC-0{idx+1}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Unique Design Features -->
        <div class="bg-white border border-bronze/10 p-6 shadow-sm">
          <span class="text-[10px] uppercase tracking-epic text-bronze-dark block mb-4 font-semibold">BESPOKE STRUCTURAL TOKENS</span>
          
          <ul class="space-y-3">
            {project.features.map((feature) => (
              <li class="flex items-start space-x-2 text-xs text-obsidian/70 leading-relaxed font-sans">
                <!-- Restricted checkmark icon boundary to prevent scaling bugs -->
                <svg class="w-4 h-4 max-w-5 max-h-4 text-bronze-dark mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Collaborators list -->
        <div class="border border-bronze/10 p-6 flex flex-col space-y-4 text-xs bg-white/50">
          <div>
            <span class="text-[9px] uppercase tracking-widest text-bronze-dark block font-semibold mb-2">Architectural Collaborators</span>
            <div class="flex flex-wrap gap-2">
              {project.collaborators.map((c) => (
                <span class="bg-white border border-bronze/10 text-obsidian/70 px-3 py-1 font-semibold rounded-none font-sans">{c}</span>
              ))}
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- QUICK NEXT COMMISSION TRANSITION -->
  <section class="py-16 bg-white/40 border-t border-bronze/10 relative">
    <div class="max-w-4xl mx-auto px-6 text-center flex flex-col items-center">
      <span class="text-[10px] uppercase tracking-epic text-bronze-dark font-semibold mb-3">ACQUIRE ARCHITECTURAL IMMORTALITY</span>
      <h3 class="text-2xl md:text-3xl font-serif text-obsidian mb-4 uppercase">Interested in commissioning a unique estate?</h3>
      <p class="text-xs text-obsidian/60 leading-relaxed max-w-xl font-light font-sans mb-6">
        We conduct complete environmental surveys, topographic layouts, and structural analyses for all inquiries. Initiate your registry files with our curators today.
      </p>
      <a href="/inquire" class="bg-obsidian hover:bg-bronze-dark text-linen hover:text-obsidian font-semibold px-8 py-3.5 rounded-full text-xs uppercase tracking-widest transition-all duration-300">
        Initiate Custom Registry
      </a>
    </div>
  </section>

</Layout>
